{
  "name": "@taskmanager/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "cd ../.. && npm run build -w packages/shared-types",
    "dev": "npm run build && node scripts/copy-migrations-to-dist.mjs && node dist/db/migrate.js && concurrently \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"node dist/index.js\"",
    "predev:e2e": "node scripts/prepare-e2e-runtime.mjs",
    "dev:e2e": "npm run build && node scripts/copy-migrations-to-dist.mjs && node scripts/ensure-e2e-db.mjs && node dist/db/migrate.js && node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "npm run build && node scripts/copy-migrations-to-dist.mjs && node dist/db/migrate.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/session": "^11.1.1",
    "@fastify/static": "^9.1.3",
    "@taskmanager/shared-types": "file:../../packages/shared-types",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^1.0.0-rc.3",
    "fastify": "^5.8.5",
    "mysql2": "^3.22.4",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.9",
    "unzipper": "^0.12.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/node": "^20.14.10",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^6.0.3",
    "@types/unzipper": "^0.10.11",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vitest/coverage-v8": "^4.1.7",
    "drizzle-kit": "^1.0.0-rc.3",
    "eslint": "^8.57.0",
    "supertest": "^7.2.2",
    "tsx": "^4.16.2",
    "typescript": "^5.4.5",
    "vitest": "^4.1.7"
  }
}
