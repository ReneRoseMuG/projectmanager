DB_HOST=localhost
DB_PORT=3306
DB_NAME=taskmanager
DB_USER=taskmanager
DB_PASSWORD=
DB_SSL=false
PORT=3001
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
PREVIEW_CACHE_DIR=./previews
PREVIEW_TEXT_MAX_BYTES=102400
PREVIEW_CONVERSION_MAX_BYTES=26214400
PREVIEW_CONVERSION_TIMEOUT_MS=15000
LIBREOFFICE_PATH=soffice
CONTENT_DIR=./content
NOTIFICATIONS_ENABLED=false
NOTIFICATION_CRON=* * * * *
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=admin@local
WEB_PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@local
ADMIN_EMAIL=admin@local
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=System
ADMIN_INITIAL_PASSWORD=
AUTH_BYPASS_ADMIN=false
# Optional static API key for external clients; keep this value secret.
API_KEY=
SESSION_SECRET=change-me-in-production

# --- MS-79 Kalender-Synchronisation ---
# HINWEIS: Die Google-/Sync-Werte unten werden bevorzugt zentral in der Datenbank gepflegt — in der
# App unter „Admin → Kalender-Synchronisation". Dort eingetragene Werte haben Vorrang; die Einträge
# hier dienen nur noch als Rückfallebene (praktisch für die Erst-Einrichtung). Einzige Ausnahme ist
# CALENDAR_ENCRYPTION_KEY — der bleibt bewusst hier (siehe unten).
#
# PFLICHT und NICHT in die Datenbank: Schlüssel zur Verschlüsselung der gespeicherten Zugangsdaten
# (Google-Refresh-Token, NextCloud-App-Passwort, Google-Client-Secret). Beliebige lange
# Zufallszeichenkette, NIE ins Repo committen. Er darf nicht neben den verschlüsselten Daten in der
# DB liegen; auf allen Rechnern (Büro, Homeoffice) muss DERSELBE Wert stehen, sonst sind die zentral
# gespeicherten Daten nicht lesbar. Beispiel erzeugen: `openssl rand -base64 48`
CALENDAR_ENCRYPTION_KEY=
# Optional (Fallback): Google OAuth-Client aus der Google Cloud Console (APIs & Dienste → Anmeldedaten
# → OAuth-Client-ID, Typ "Webanwendung"). Besser zentral in der App hinterlegen.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional (Fallback): Rücksprung-Adresse nach der Google-Anmeldung. Muss identisch als "Autorisierter
# Redirect-URI" in der Google Cloud Console hinterlegt sein (in Produktion die öffentliche https-Adresse).
GOOGLE_REDIRECT_URI=http://localhost:3001/api/calendar-connections/google/callback
# Optional (Fallback): automatischer periodischer Abgleich aller Verbindungen im Hintergrund (Standard aus).
CALENDAR_SYNC_ENABLED=false
# Optional (Fallback): Intervall des automatischen Abgleichs in Millisekunden (Standard 15 Minuten).
CALENDAR_SYNC_INTERVAL_MS=900000
# Optional (Fallback): öffentlich erreichbare https-Webhook-URL für Google-Push (sofortige
# Benachrichtigung statt Polling). Ohne diese bleibt der periodische Abgleich der Weg.
GOOGLE_PUSH_WEBHOOK_URL=
