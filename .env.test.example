# Kopiere diese Datei als .env.test und trage deine lokalen MySQL-Credentials ein.
# Diese Datei wird von den Integration-Tests gelesen und NICHT committed.
#
# Der Test-User braucht CREATE DATABASE und DROP DATABASE Rechte.
# Empfehlung: root-User der lokalen MySQL-Instanz (MySQL Workbench → Connections).

TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306
TEST_DB_USER=root
TEST_DB_PASSWORD=dein-root-passwort
