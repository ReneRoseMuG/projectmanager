# Lokale Projekt-Manager-Konfiguration.
# Diese Datei als `.env.local` kopieren und pro Rechner anpassen.

# API und MCP verwenden denselben lokalen API-Key.
API_KEY=change-me-local-api-key
PROJECT_MANAGER_API_KEY=change-me-local-api-key

# SSH-Tunnel zur MySQL-Datenbank automatisch mit `npm run dev` starten.
# Aktivieren wenn die DB nur über SSH erreichbar ist (z. B. Shared Hosting).
DB_MYSQL_TUNNEL_AUTOSTART=false

# Optional: MCP und ChatGPT-Tunnel automatisch mit `npm run dev`
# und `Projekt Manager starten.bat` starten.
PROJECT_MANAGER_MCP_AUTOSTART=false
PROJECT_MANAGER_MCP_TUNNEL_AUTOSTART=false

# ChatGPT-Developer-Mode kann für lokale Tests ohne MCP-Bearer-Header arbeiten.
# Nur mit privatem, stabilem Tunnel verwenden.
MCP_HTTP_AUTH_MODE=none
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3010
MCP_HTTP_PATH=/mcp

# Alternative für Bearer-geschützte MCP-Clients:
# MCP_HTTP_AUTH_MODE=bearer
# MCP_HTTP_BEARER_TOKEN=change-me-mcp-bearer-token

# Stabile HTTPS-Tunnel-URL und lokaler Tunnel-Befehl, z. B. Cloudflare oder ngrok.
MCP_PUBLIC_URL=https://your-stable-tunnel.example.com/mcp
MCP_TUNNEL_COMMAND=cloudflared tunnel run projekt-manager-home
